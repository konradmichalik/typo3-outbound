{
	"name": "konradmichalik/typo3-outbound",
	"description": "Outbound - Declarative API clients for TYPO3: describe external APIs as PHP interfaces with attributes, with retries, caching, rate limits, format profiles and safe defaults.",
	"license": [
		"GPL-2.0-or-later"
	],
	"type": "typo3-cms-extension",
	"authors": [
		{
			"name": "Konrad Michalik",
			"email": "hej@konradmichalik.dev",
			"role": "Maintainer"
		}
	],
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"ext-mbstring": "*",
		"ext-tokenizer": "*",
		"cuyz/valinor": "^2.7",
		"psr/http-message": "^1.0 || ^2.0",
		"psr/http-server-handler": "^1.0.2",
		"psr/http-server-middleware": "^1.0.2",
		"psr/log": "^2.0 || ^3.0",
		"symfony/console": "^7.4",
		"symfony/dependency-injection": "^7.4",
		"symfony/http-client": "^7.4",
		"symfony/http-client-contracts": "^3.5",
		"symfony/http-foundation": "^7.4",
		"symfony/mime": "^7.4",
		"symfony/rate-limiter": "^7.4.23",
		"symfony/yaml": "^7.4",
		"typo3/cms-core": "^13.4 || ^14.0"
	},
	"require-dev": {
		"eliashaeussler/typo3-vendor-bundler": "^4.1.2",
		"eliashaeussler/version-bumper": "^4.1.3",
		"phpunit/phpunit": "^11.5 || ^12.0",
		"psr/container": "^2.0",
		"symfony/config": "^7.4",
		"typo3/cms-base-distribution": "^13.4 || ^14.0",
		"typo3/cms-extbase": "^13.4 || ^14.0",
		"typo3/cms-fluid": "^13.4 || ^14.0",
		"typo3/cms-frontend": "^13.4 || ^14.0",
		"typo3/testing-framework": "^8.2 || ^9.0"
	},
	"autoload": {
		"psr-4": {
			"KonradMichalik\\Typo3Outbound\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"KonradMichalik\\OutboundPetstore\\": "Tests/Functional/Fixtures/Extensions/outbound_petstore/Classes/",
			"KonradMichalik\\Typo3Outbound\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"eliashaeussler/typo3-vendor-bundler": true,
			"eliashaeussler/version-bumper": true,
			"php-http/discovery": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	},
	"extra": {
		"konradmichalik/php-cs-fixer-preset": {
			"copyright": 2026
		},
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "typo3_outbound",
			"version": "0.1.0",
			"web-dir": "public"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@cgl install"
		],
		"cgl": "@composer -d Tests/CGL --",
		"demo": "php -S localhost:8080 -t Tests/Demo/public",
		"test": "@test:unit",
		"test:coverage": "phpunit -c phpunit.xml",
		"test:functional": "phpunit -c phpunit.functional.xml",
		"test:live": "OUTBOUND_LIVE=1 phpunit -c phpunit.xml --testsuite Integration --no-coverage",
		"test:unit": "phpunit -c phpunit.xml --no-coverage"
	}
}
