includes:
	- phpstan-baseline.neon
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- %rootDir%/../../shipmonk/dead-code-detector/rules.neon
	- %rootDir%/../../konradmichalik/phpstan-typo3-dead-code/rules.neon

parameters:
	level: max

	scanDirectories:
		- ../../vendor
		- ../../Tests/Support
		- ../../Tests/Functional/Fixtures/Extensions/outbound_petstore/Classes
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../ext_localconf.php
		- ../../Tests/Unit

	excludePaths:
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_emconf.php
