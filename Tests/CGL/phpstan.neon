includes:
	- phpstan-baseline.neon
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist

parameters:
	level: max

	scanDirectories:
		- ../../vendor
		- ../../Tests/Support
		- ../../Tests/Functional/Fixtures/Extensions/outbound_petstore/Classes
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Tests/Unit

	excludePaths:
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_emconf.php
