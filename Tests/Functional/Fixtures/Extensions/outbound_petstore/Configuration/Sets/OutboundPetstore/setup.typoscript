# Renders the Petstore plugin as the whole page body, for quick manual testing.
page = PAGE
page {
  typeNum = 0
  10 = EXTBASEPLUGIN
  10 {
    extensionName = OutboundPetstore
    pluginName = Pets
  }
}

# Uncached variant for `ddev benchmark`: the plugin runs on every request, the response cache of typo3_outbound stays in play.
benchmark = PAGE
benchmark {
  typeNum = 1794
  config.no_cache = 1
  10 < page.10
}
